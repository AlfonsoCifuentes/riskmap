# ============================================================================
# RiskMap — environment template
# ============================================================================
# Copy to `.env` and fill in ONLY what you need. RiskMap is designed to run at
# €0/month: the core pipeline works with free/open sources and no paid keys.
# Every key below is OPTIONAL unless marked REQUIRED. Missing optional keys
# degrade a capability gracefully (DEGRADED / DISABLED) — they never crash the
# pipeline.
#
# NEVER put real secrets in this file — it is committed to a public repo.
# Real values belong in `.env` (git-ignored) or in the Vercel/GitHub secrets UI.
# ============================================================================

# --- Database (REQUIRED for the API and pipeline) ---------------------------
# Production: a Neon/Postgres connection string, e.g.
#   postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Local dev / tests may use SQLite, e.g. sqlite:///data/riskmap.db
DATABASE_URL=

# --- News / event ingestion -------------------------------------------------
# Core ingestion uses free RSS + GDELT and needs no key. NewsAPI is an OPTIONAL
# enrichment source; if absent the pipeline continues normally.
NEWSAPI_KEY=

# --- AI provider (OPTIONAL) -------------------------------------------------
# Used for structured classification / translation / summaries. Without a key
# the pipeline falls back to local heuristics and reports DEGRADED (not FAILED).
# See src/ai/model_registry.py for the task -> model mapping.
GROQ_API_KEY=
# Optional per-task model overrides (defaults live in model_registry.py):
RISKMAP_MODEL_CLASSIFIER=
RISKMAP_MODEL_TRANSLATOR=
RISKMAP_MODEL_SUMMARIZER=
RISKMAP_MODEL_GEO=
# Other AI providers (all optional / off by default):
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
HUGGINGFACE_TOKEN=
DEEPL_API_KEY=

# --- Earth Observation (OPTIONAL) -------------------------------------------
# NASA FIRMS fire hotspots — free MAP_KEY from https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=
# Copernicus Data Space (Sentinel-1/-2) — free tier OAuth client credentials.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
# Legacy Sentinel Hub instance variables (only if you use SH directly):
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=
SENTINEL_INSTANCE_ID=

# --- Feature flags / kill switches ------------------------------------------
# Turn experimental / expensive subsystems off without touching code.
FEATURE_VISUAL_INTELLIGENCE=false
FEATURE_FORECASTING=false
FEATURE_SATELLITE_CV=false
FEATURE_ALERTS=false
DISABLE_AI=false
DISABLE_EO=false
DISABLE_CAMERA_FETCH=true
DISABLE_NOTIFICATIONS=true

# --- Cost guardrails (see config/budget.py) ---------------------------------
RISKMAP_MAX_MONTHLY_BUDGET_EUR=10
RISKMAP_AI_DAILY_REQUEST_LIMIT=500
RISKMAP_EO_DAILY_REQUEST_LIMIT=10
RISKMAP_MAX_STORED_IMAGES=2000

# --- App / runtime ----------------------------------------------------------
SUPPORTED_LANGUAGES=es,en
DATA_COLLECTION_INTERVAL=7200
MAX_ARTICLES_PER_SOURCE=100
NLP_MODEL=xlm-roberta-base
SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment
SUMMARIZATION_MODEL=facebook/bart-large-cnn
FLASK_SECRET_KEY=
FLASK_DEBUG=false

# --- Notifications (OPTIONAL) -----------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERTS_MAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# --- Misc data providers (OPTIONAL) -----------------------------------------
EIA_API_KEY=
