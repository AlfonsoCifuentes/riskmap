{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "rewrites": [
    { "source": "/static/(.*)", "destination": "/src/web/static/$1" },
    { "source": "/((?!api/).*)", "destination": "/public/index.html" }
  ],
  "env": {
    "NEON_API_URL": "${NEON_API_URL}",
    "NEON_API_KEY": "${NEON_API_KEY}",
    "DATABASE_URL": "${DATABASE_URL}"
  }
}
