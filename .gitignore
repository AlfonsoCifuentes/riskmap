# ============================================
# RiskMap .gitignore — Clean Architecture
# ============================================

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
.venv_dashboard/
venv/
env/
ENV/
.Python

# Environment secrets (NEVER commit)
.env
.env.local
.env.*.local

# IDE / Editor
.idea/
*.swp
*.swo
*~

# OS metadata
.DS_Store
Thumbs.db
ehthumbs.db
._*
.Spotlight-V100
.Trashes

# Build artifacts
build/
dist/
*.egg-info/
.eggs/

# Node
node_modules/

# ============================================
# Data — track structure, ignore heavy content
# ============================================

# Databases (large binary, generated locally)
data/*.db
data/*.db.*
*.sqlite
*.sqlite3
alerts.db
satellite_analysis.db

# Cached / generated images (regenerated at runtime)
data/images/
data/image_cache/
data/satellite_images/
src/web/static/images/article_*
src/dashboard/static/images/
static/images/article_*

# External feed caches
data/external_feeds/

# ============================================
# Logs (generated at runtime)
# ============================================
*.log
logs/*.json
logs/*.log

# ============================================
# ML Models (too large for git)
# ============================================
*.pt
*.pth
*.onnx
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib
*.bin
*.tflite
*.model
models/predictive/

# ============================================
# Temporary / generated files
# ============================================
*.tmp
*.temp
*.bak
*.backup
*.old
*.orig
*.corrupted
*.ssl_backup
*.yolo_backup

# Temp images from processing
temp_military_*.jpg

# ============================================
# Large media (never commit)
# ============================================
*.mp4
*.avi
*.mov
*.mkv
*.wmv
*.flv
*.webm
*.mp3
*.wav
*.flac
*.tiff
*.tif
*.bmp
*.raw
*.fbx
*.mtl
*.zip
*.tar.gz
*.rar
*.7z
*.iso

# ============================================
# Tool caches
# ============================================
.cache/
.tmp/
.qodo/
.agents/
_vscode/
